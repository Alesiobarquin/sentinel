# Documentation of local defaults. No credentials are needed for bootstrap.
# The Python CLI reads exported environment variables, not this file.
SENTINEL_PROMETHEUS_URL=http://127.0.0.1:9090
SENTINEL_JAEGER_URL=http://127.0.0.1:8080/jaeger/ui
SENTINEL_OPENSEARCH_URL=http://127.0.0.1:9200
SENTINEL_AUDIT_PATH=var/audit/tool-calls.jsonl
# Optional live log tests: verified for the pinned local Demo 3.1.0.
# Reinspect mappings/documents when changing the target.
# SENTINEL_LOG_INDEX=otel-logs*
# SENTINEL_LOG_SCHEMA=infra/docker/log-schema.json
# SENTINEL_LIVE_SERVICE=payment

# ChatGPT mode uses explicit browser consent: make login, then make models.
# This directory contains protected credentials; never share its contents.
# SENTINEL_AUTH_DIR=/absolute/private/path/sentinel-auth
SENTINEL_MODEL=gpt-6-luna
# Optional host-to-demo collector export; local JSONL spans are always saved.
SENTINEL_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Enable Kubernetes only when the investigation target uses it.
# The fixture is separate from the Compose application.
# SENTINEL_KUBERNETES_CONFIG=.cache/kind/reader.json
# API-key mode requires --billing-mode api and separately billed access.
# OPENAI_API_KEY=your-local-key
